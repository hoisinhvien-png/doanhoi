# Mẫu biến môi trường. Sao chép thành file .env rồi điền giá trị thật.
# File .env KHÔNG được đưa lên GitHub.

# Chuỗi kết nối PostgreSQL (Aiven → Service URI)
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require"

# Nội dung chứng chỉ CA của Aiven (file ca.pem), giữ nguyên các dòng
DATABASE_CA="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# Khoá ký phiên đăng nhập: chuỗi ngẫu nhiên ≥ 32 ký tự
SESSION_SECRET=""

# Số kết nối CSDL tối đa mỗi tiến trình (gói Aiven miễn phí: để 3)
DB_POOL_MAX="3"

# Chỉ dùng khi chạy seed lần đầu (npx prisma db seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Chỉ dùng khi chạy thử trên máy (npm run seed:demo)
DEMO_PASSWORD=""
