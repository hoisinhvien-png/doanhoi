// Sơ đồ cơ sở dữ liệu – Hệ thống theo dõi hoạt động Đoàn – Hội, Trường ĐH Hà Tĩnh
// Dựa trên tài liệu đặc tả, mục II, có bổ sung (ghi chú "Bổ sung" bên dưới).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Vai trò người dùng
enum Role {
  ADMIN   // Đoàn trường
  LCD     // Liên chi Đoàn khoa
  STUDENT // Sinh viên
}

/// Nơi sinh viên gửi ý kiến tới (Bổ sung 22/11/2026; bỏ Hội SV 22/11/2026 - gộp vào Đoàn trường)
enum FeedbackRecipient {
  DOAN_TRUONG   // Đoàn trường
  LIEN_CHI_DOAN // Liên chi Đoàn khoa
}

/// Đánh giá của sinh viên sau khi nhận phản hồi (Bổ sung 22/11/2026)
enum FeedbackSatisfaction {
  LIKE   // Hài lòng
  UNLIKE // Chưa hài lòng
}

/// Trạng thái lượt đăng ký sự kiện (từ 22/11/2026 dùng đủ 3 trạng thái).
/// Sinh viên đăng ký tham gia -> PENDING. Sau sự kiện, LCĐ chốt trong 7 ngày:
///   CONFIRMED = Tham gia (tính điểm xếp loại); REJECTED = Không tham gia theo thực tế.
enum ParticipationStatus {
  PENDING   // Chờ xác nhận (SV đã đăng ký)
  CONFIRMED // Tham gia
  REJECTED  // Không tham gia
}

/// Loại ý kiến sinh viên gửi (Bổ sung 22/11/2026)
enum FeedbackCategory {
  SUGGESTION // Góp ý hoạt động
  COMPLAINT  // Khiếu nại
  QUESTION   // Câu hỏi
  OTHER      // Khác
}

/// Trạng thái xử lý ý kiến (Bổ sung 22/11/2026)
enum FeedbackStatus {
  NEW         // Mới gửi, chưa ai trả lời
  IN_PROGRESS // SV đã gửi tiếp, đang chờ cán bộ trả lời
  ANSWERED    // Cán bộ đã phản hồi, chờ SV xem
  CLOSED      // Đã đóng
}

/// Bảng 1: Người dùng & Sinh viên
model User {
  id                 String    @id @default(cuid())
  studentId          String?   @unique // Mã SV; để trống với tài khoản Đoàn trường, LCĐ
  username           String?   @unique // Bổ sung: tên tài khoản sinh viên, vd DIEUTH2025_NN
  locked             Boolean   @default(false) // Bổ sung: tài khoản bị khoá, không đăng nhập được
  name               String
  dob                DateTime? @db.Date
  className          String?   // Lớp sinh hoạt
  faculty            String?   // Khoa; với tài khoản LCĐ là khoa được quản lý
  role               Role      @default(STUDENT)
  email              String?   @unique // Đăng nhập cho Đoàn trường, LCĐ
  password           String    // Mật khẩu đã băm bằng bcrypt
  mustChangePassword Boolean   @default(true) // Bổ sung: bắt đổi mật khẩu lần đầu
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  participations EventParticipation[] @relation("Participant")
  approvals      EventParticipation[] @relation("Approver")
  createdEvents  Event[]
  feedbacks      Feedback[]           @relation("FeedbackAuthor")
  feedbackReplies FeedbackReply[]     @relation("ReplyAuthor")

  @@index([faculty])
  @@index([className])
}

/// Bảng 2: Sự kiện
model Event {
  id               String   @id @default(cuid())
  title            String
  date             DateTime // Ngày giờ diễn ra
  description      String?  @db.Text
  location         String?  // Bổ sung: địa điểm
  faculty          String?  // Bổ sung: để trống = sự kiện toàn trường
  registrationOpen Boolean  @default(true) // Bổ sung: mở/đóng đăng ký
  createdById      String?
  createdBy        User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  participations EventParticipation[]
  feedbacks      Feedback[]

  @@index([date])
}

/// Bảng 3: Lịch sử đăng ký
model EventParticipation {
  id            String              @id @default(cuid())
  userId        String // Trỏ tới User.id (đặc tả gọi là studentId)
  user          User                @relation("Participant", fields: [userId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status        ParticipationStatus @default(PENDING)
  confirmedById String? // Cán bộ LCĐ đã duyệt
  confirmedBy   User?               @relation("Approver", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime? // Bổ sung: thời điểm duyệt
  createdAt     DateTime            @default(now()) // Thời gian bấm đăng ký

  @@unique([userId, eventId]) // Một sinh viên chỉ đăng ký một sự kiện một lần
  @@index([status])
}

/// Bổ sung: ngưỡng xếp loại đoàn viên, Đoàn trường sửa được trên web
model GradingRule {
  id       String @id @default(cuid())
  label    String @unique // Ví dụ: Khá, Trung bình, Yếu
  minScore Float  // Điểm tối thiểu (thang 10)
  order    Int    // Thứ tự hiển thị, mức cao nhất = 1
}

/// Bảng 4: Ý kiến sinh viên (Bổ sung 22/11/2026)
/// Sinh viên gửi ý kiến -> định tuyến về LCĐ khoa mình (faculty) và Đoàn trường thấy tất cả.
/// anonymous = true: cán bộ không thấy tên/lớp người gửi, nhưng SV vẫn nhận phản hồi trong tài khoản.
model Feedback {
  id          String           @id @default(cuid())
  authorId    String
  author      User              @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  faculty     String? // Sao chép khoa của SV lúc gửi, để định tuyến tới LCĐ
  recipient   FeedbackRecipient @default(LIEN_CHI_DOAN) // Nơi SV chọn gửi tới
  anonymous   Boolean           @default(false)
  satisfaction FeedbackSatisfaction? // SV đánh giá sau khi nhận phản hồi
  category    FeedbackCategory  @default(SUGGESTION)
  title       String
  content     String           @db.Text
  eventId     String? // Sự kiện liên quan (không bắt buộc)
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status      FeedbackStatus   @default(NEW)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lastReplyAt DateTime? // Thời điểm phản hồi/trao đổi gần nhất

  replies FeedbackReply[]

  @@index([faculty])
  @@index([status])
}

/// Bảng 5: Trao đổi trong một ý kiến (Bổ sung 22/11/2026)
model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorRole Role // Vai trò người viết lúc gửi (để hiển thị dù tài khoản bị xoá)
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}
